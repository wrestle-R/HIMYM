{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legend-dairy.local/dataset/schema.json",
  "title": "Legend-dairy normalized archive dataset",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "step": {
      "type": "object",
      "required": ["order", "text"],
      "additionalProperties": false,
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "play": {
      "type": "object",
      "required": ["id", "slug", "title", "summary", "steps", "contentKind", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slug": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 6, "maxItems": 15, "items": { "$ref": "#/$defs/step" } },
        "contentKind": { "enum": ["transcribed", "reconstructed"] },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "featured": { "type": "boolean" }
      }
    },
    "episode": {
      "type": "object",
      "required": ["id", "season", "number", "code", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "season": { "type": "integer", "minimum": 1, "maximum": 9 },
        "number": { "type": "integer", "minimum": 1 },
        "code": { "type": "string", "pattern": "^S\\d{2}E\\d{2}$" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "playAppearance": {
      "type": "object",
      "required": ["id", "playId", "episodeId", "status", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^pa-\\d{3}$" },
        "playId": { "$ref": "#/$defs/id" },
        "episodeId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["used", "featured", "mentioned", "demonstrated", "entire-episode", "revealed", "briefly-visible", "implied-success"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
